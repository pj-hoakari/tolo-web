{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>pj-hoakari/renovate-config",
    "customManagers:biomeVersions"
  ],
  "packageRules": [
    {
      "description": "Disable minimum release age checks for internal dependencies",
      "matchPackageNames": ["@pj-hoakari/*"],
      "minimumReleaseAge": null
    },
    {
      "description": "Update the Playwright Docker image and npm packages together",
      "matchPackageNames": [
        "playwright",
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ],
      "groupName": "playwright"
    }
  ]
}
