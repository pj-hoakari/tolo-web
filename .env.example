NPM_TOKEN=ghp_xxx

NEXT_PUBLIC_CROWD_DETECTION_MODEL_PATH=/models/yolo26n.onnx

# tolo-edge-bridge base URL
SIGNALING_URL=http://127.0.0.1:8787
# URL written to ESP32 cameras when it differs from SIGNALING_URL
SIGNALING_PUBLIC_URL=

FIREBASE_PROJECT_ID=tolo-signaling
FIREBASE_API_KEY=demo-tolo-web
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

NEXT_PUBLIC_API_MOCKING=enabled
OBSERVATION_API_MOCKING=disabled
TENANT_SUBDOMAIN_MOCKING=enabled
AUTH_MOCKING=enabled
AUTH_MOCKING_ALLOWED_ROOT_DOMAINS=

AUTH_DATABASE_URL=
AUTH_SECRET=
AUTH_IDP_ISSUER=
AUTH_IDP_CLIENT_ID=console-ui
AUTH_IDP_CLIENT_SECRET=
# The confidential client the BFF uses for observation camera connections.
# These are only required when /api/auth/connection/start is used.
AUTH_IDP_CONNECTION_CLIENT_ID=observation-connection
AUTH_IDP_CONNECTION_CLIENT_SECRET=
AUTH_CONNECTION_REDIRECT_URI=http://localhost:3000/api/auth/connection/callback
AUTH_CONNECTION_TTL_SECONDS=86400
AUTH_RESOURCE_HOST=

GATEWAY_URL=http://127.0.0.1:8080
OBSERVATION_ACCESS_TOKEN=
GRAPH_ACCESS_TOKEN=
TENANT_ACCESS_TOKEN=
FAKEIDP_URL=http://localhost:8082
