{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!pnpm-workspace.yaml",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!public/onnxruntime",
      "!public/mockServiceWorker.js",
      "!.devcontainer",
      "!.vscode"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": {
    "stylesheet": "src/app/globals.css",
    "mergeFunctions": ["clsx", "cn", "twMerge"],
    "variantFunctions": ["cva", "tv"],
    "attributes": ["class", "className"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "error"
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["public/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
